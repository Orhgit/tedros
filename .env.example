# Tedros — local development env. Copy to `.env` and adjust as needed.
# `app/lib/env.server.ts` validates these with Zod at boot.

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# Postgres — defaults match docker-compose.dev.yml
DATABASE_URL=postgres://tedros:tedros_dev@localhost:5432/tedros

# Redis (optional in dev; required for rate-limit/Auth.js sessions in prod)
REDIS_URL=redis://localhost:6379

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET=replace-with-32-byte-random-string-aaaaaaaaaaaaaa
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth (optional in dev — leave blank to hide the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mula AI chatbot — get key from console.anthropic.com
ANTHROPIC_API_KEY=

# Magic-link email — defaults to MailHog from docker-compose.dev.yml
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=no-reply@tedros.local
