# Tedros — local development env. Copy to `.env` and adjust as needed.
# `app/lib/env.server.ts` validates these with Zod at boot.

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# Postgres — defaults match docker-compose.dev.yml
DATABASE_URL=postgres://tedros:tedros_dev@localhost:5432/tedros

# Redis (optional in dev; required for rate-limit/Auth.js sessions in prod)
REDIS_URL=redis://localhost:6379

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET=replace-with-32-byte-random-string-aaaaaaaaaaaaaa
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth (optional in dev — leave blank to hide the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link email — defaults to MailHog from docker-compose.dev.yml
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=no-reply@tedros.local

# Resend (TED-22) — leave RESEND_API_KEY blank in dev to use the no-op mock
# adapter that logs to stdout instead of calling api.resend.com.
RESEND_API_KEY=
RESEND_FROM=no-reply@tedros.local
LEADS_DEFAULT_TO_EMAIL=admin@tedros.local

# Cloudflare Turnstile (optional). When TURNSTILE_SECRET_KEY is unset,
# only the honeypot field protects the lead form.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
