# Tedros — production env template. Copy to `.env.production` on the
# host and fill real values. Validated by `app/lib/env.server.ts` (Zod).
# Secrets MUST NOT be committed; this file is the public template only.

NODE_ENV=production
PORT=3000
PUBLIC_URL=https://tedros.co.il

# Postgres — host=postgres (compose service), credentials must match
# POSTGRES_PASSWORD below. Generate: `openssl rand -base64 32`.
POSTGRES_PASSWORD=replace-with-32-byte-random-string
DATABASE_URL=postgres://tedros:replace-with-32-byte-random-string@postgres:5432/tedros

# Redis — required in prod (rate-limit + Auth.js sessions).
REDIS_URL=redis://redis:6379

# Auth.js — generate: `openssl rand -base64 32` (≥32 chars enforced)
AUTH_SECRET=replace-with-32-byte-random-string
AUTH_URL=https://tedros.co.il
AUTH_TRUST_HOST=true

# Google OAuth (optional — leave blank to hide the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link email server (Resend SMTP, leave blank to disable SMTP path)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=hello@tedros.co.il

# Resend API (TED-22) — leaving blank uses the no-op mock adapter
RESEND_API_KEY=
RESEND_FROM=hello@tedros.co.il
LEADS_DEFAULT_TO_EMAIL=admin@tedros.co.il
ADMIN_NOTIFICATIONS_EMAIL=admin@tedros.co.il

# Cloudflare Turnstile (optional — omitting keys disables verification)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
